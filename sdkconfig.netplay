# Netplay Build Configuration
# This file enables netplay support across all retro-go components

# Enable netplay globally
CONFIG_RG_ENABLE_NETPLAY=y

# Enable networking (required for netplay)
CONFIG_RG_ENABLE_NETWORKING=y

# WiFi configuration
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Network stack configuration
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_MSS=1436
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=12
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# Increase task stack sizes for netplay
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Enable required protocols
CONFIG_LWIP_TCP=y
CONFIG_LWIP_UDP=y

# Performance optimizations
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_MSL=60000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=20000

# Memory optimization
CONFIG_LWIP_MEM_SIZE=32768
CONFIG_LWIP_MEMP_NUM_TCP_PCB=16
CONFIG_LWIP_MEMP_NUM_UDP_PCB=16

# Enable task watchdog with longer timeout for netplay
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Enable additional heap for netplay buffers
CONFIG_ESP32_WIFI_IRAM_OPT=y
CONFIG_ESP32_WIFI_RX_IRAM_OPT=y
